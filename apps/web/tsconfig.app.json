{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/out-tsc/app",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // The base ts-config sets `noEmit: true` (correct for type-check-only library
    // builds). The Angular `application` builder, however, switches to the ngtsc
    // emit path whenever source maps are enabled (i.e. `ng serve` / dev builds);
    // `noEmit: true` then blocks emission and the compiler reports every source
    // file as "not found in TypeScript compilation". Apps must emit, so override it.
    "noEmit": false,
    "types": []
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts", "src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "e2e/**"]
}
