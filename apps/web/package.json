{
  "name": "@tkf/web",
  "version": "0.0.0",
  "private": true,
  "description": "Task Kanban Flow — user-facing Angular 21 application.",
  "type": "module",
  "scripts": {
    "build": "ng build --configuration production",
    "dev": "ng serve --port 4200",
    "lint": "eslint src --max-warnings 0",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "clean": "rm -rf node_modules .turbo dist coverage playwright-report test-results"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/localize": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@ngrx/signals": "^21.0.0",
    "@sentry/angular": "^9.0.0",
    "@tkf/api-client": "workspace:*",
    "@tkf/design-tokens": "workspace:*",
    "@tkf/shared-types": "workspace:*",
    "@tkf/shared-utils": "workspace:*",
    "@tkf/ui": "workspace:*",
    "msw": "^2.7.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/language-service": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/angular": "^19.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^16.1.0",
    "typescript": "^5.6.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
