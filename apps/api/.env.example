# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS). The Angular web app:
WEB_ORIGIN=http://localhost:4200

# ── Secrets (REQUIRED in production; auto-generated ephemeral in dev) ────────
# Generate strong values, e.g.:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Server-side pepper mixed into every password hash and API-key hash. Rotating
# this invalidates all existing hashes, so treat it like a root credential.
PASSWORD_PEPPER=
APIKEY_PEPPER=

# 32-byte key (base64 or 64-char hex) for AES-256-GCM encryption of vault
# secrets at rest.  Generate:  openssl rand -base64 32
SECRETS_ENC_KEY=

# ── Tokens / cookies ────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=1209600     # seconds (14 days)
COOKIE_SECURE=false           # set true behind HTTPS in production

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300            # requests per window per IP (global)
RATE_LIMIT_WINDOW=60000       # window in ms
AUTH_RATE_LIMIT_MAX=10        # stricter cap for auth endpoints per window

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/tkf.db
